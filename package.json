{
  "scripts": {
    "test": "npm run clean:allure && npx wdio run ./wdio.conf.ts",
    "wdio": "wdio run ./wdio.conf.ts",
    "clean:allure": "rimraf allure-results allure-report tmp",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:publish": "npm run allure:generate && npm run allure:open",
    "test:withAllure": "npm run test && npm run allure:publish"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@wdio/allure-reporter": "^10.1.0",
    "@wdio/cli": "^10.1.0",
    "@wdio/cucumber-framework": "^10.1.0",
    "@wdio/globals": "^10.1.0",
    "@wdio/local-runner": "^10.1.0",
    "@wdio/spec-reporter": "^10.1.0",
    "@wdio/types": "^10.1.0",
    "expect-webdriverio": "^8.0.0",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  }
}
